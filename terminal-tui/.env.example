# Copy to .env inside terminal-tui/ when the API is not local/default.
# The TUI (Node) and the API (Python FastAPI) run on different URLs.
WEBVAPT_API_URL=http://127.0.0.1:8000/api/v1
# Must match API_KEY in the project-root .env when API auth is enabled.
# Leave empty when the API has no API_KEY set.
WEBVAPT_API_KEY=
