# AI provider (OpenRouter, OpenAI-compatible)
OPENAI_API_KEY='your_api_key_here'
CUSTOM_AI_BASE_URL='https://openrouter.ai/api/v1'
# Comma-separated priority list — first working model wins (failover on 404/429/5xx).
# Benchmarked 2026-10: nemotron-3-super (fastest) > north-mini-code > lfm-2.5.
# Re-check with: python scripts/benchmark_free_models.py
AI_MODEL='nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free,liquid/lfm-2.5-2.6b:free'
ENABLE_AI_ANALYSIS=true

# API auth (sent as X-API-Key by the TUI)
API_KEY='your_api_key_here'

# Allow scanning local/private targets (needed for local Docker targets)
ALLOW_PRIVATE_TARGETS=true

# Default crawl depth when the scan request doesn't specify a page count
MAX_PAGES_TO_CRAWL=20

# Findings per AI call (default 25). Set to 1 for one call per finding:
# most thorough analysis, but slow and rate-limit prone on free tiers.
# AI_BATCH_SIZE=25
